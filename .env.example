# FIELDPROOF Environment Configuration
# Copy to .env and fill in values. Never commit .env to Git.

# Session / JWT signing secret (generate with: openssl rand -hex 64)
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_64_CHARS

# Database encryption key (for future field-level encryption; generate with: openssl rand -hex 32)
DATABASE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# API server port (default: 3001)
PORT=3001

# SQLite database path (default: ./data/fieldproof.db)
DB_PATH=./data/fieldproof.db

# Node environment
NODE_ENV=development
